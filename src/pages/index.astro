---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getFeaturedWork } from "../data/work";

const lineItems = [
  ["01", "Product systems", "Make the path through a problem visible"],
  ["02", "Data work", "Turn uncertain records into useful decisions"],
  ["03", "Reliability", "Leave the system easier to trust after launch"],
];

const featuredWork = getFeaturedWork();
---

<BaseLayout>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-grid">
      <div class="identity">
        <p class="eyebrow">Engineering ledger</p>
        <h1 id="intro-title">Owen Abel Amenze</h1>
        <p>
          I am a software engineer in London. I solve problems by making systems
          clearer, calmer, and more reliable when real people start depending on
          them.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button-link" href="#selected-work">Selected work</a>
          <!--email_off-->
          <a class="button-link" href="#contact"
            >Start a conversation</a
          >
          <!--/email_off-->
        </div>
      </div>

      <aside class="invoice-box" aria-label="Site note">
        <dl>
          <dt>Document:</dt>
          <dd>INDEX-ABEL</dd>
          <dt>Issued:</dt>
          <dd>May 2026</dd>
          <dt>Status:</dt>
          <dd>Present</dd>
          <dt>Method:</dt>
          <dd>Clarify, build, verify</dd>
        </dl>
      </aside>
    </div>

    <div class="section">
      <table class="ledger">
        <caption>Current Practice</caption>
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Area</th>
            <th scope="col">Use</th>
          </tr>
        </thead>
        <tbody>
          {
            lineItems.map(([no, area, use]) => (
              <tr>
                <td>{no}</td>
                <td>{area}</td>
                <td>{use}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <hr class="rule double-rule" />
    </div>
  </section>

  <section class="home-continuation" id="selected-work" aria-labelledby="selected-work-heading">
    <div class="section-header">
      <h2 id="selected-work-heading">Work</h2>
      <p>
        A short index of systems where the problem was not just writing code,
        but making the path through uncertainty easier to operate.
      </p>
    </div>

    <div class="work-list home-work-list">
      {
        featuredWork.map((item) => (
          <article class="work-item home-work-item">
            <span>{item.year}</span>
            <div>
              <h3>
                <a href={item.href}>{item.name}</a>
              </h3>
              <p>{item.detail}</p>
            </div>
            <span class="work-role">{item.role}</span>
          </article>
        ))
      }
    </div>

    <p class="continuation-link">
      <a href="/work">View the full work ledger</a>
    </p>
  </section>

  <section class="home-continuation" id="contact" aria-labelledby="home-contact-heading">
    <div class="section-header">
      <h2 id="home-contact-heading">Contact</h2>
      <p>Hit me up anytime. I like thoughtful work and clear conversations.</p>
    </div>

    <div class="contact-panel home-contact-panel">
      <div class="contact-row">
        <span>Email</span>
        <!--email_off-->
        <a href="mailto:work@owenabel.com">work@owenabel.com</a>
        <!--/email_off-->
      </div>
      <div class="contact-row">
        <span>Links</span>
        <span>
          <a href="/contact">Contact page</a>
          <span aria-hidden="true"> / </span>
          <a href="/owen-abel-amenze-cv.pdf">CV</a>
        </span>
      </div>
    </div>
  </section>
</BaseLayout>
