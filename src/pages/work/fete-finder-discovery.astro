---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyInteractions from "../../components/CaseStudyInteractions.astro";
import RelatedCaseStudies from "../../components/RelatedCaseStudies.astro";

const threads = [
  {
    key: "discover",
    label: "Find the night",
    tension: "A large programme needed to feel searchable by half-formed intent: area, date, genre, venue, price, and mood.",
    owned: "Built search, filters, and maps around how people actually choose a night.",
    proof: "A vague idea could become a manageable set of events.",
  },
  {
    key: "plan",
    label: "Plan a route",
    tension: "Finding one event was not enough; people needed to save stops, order a night, and share it.",
    owned: "Turned saved events into timed routes that could be adjusted and shared.",
    proof: "Browsing could become a plan instead of a collection of open tabs.",
  },
  {
    key: "return",
    label: "Share and return",
    tension: "Links and saved plans needed to survive programme edits and weak connections.",
    owned: "Made event identity, sharing, offline state, and sync work as one return path.",
    proof: "Plans remained useful after the first visit.",
  },
];

const mechanisms = [
  {
    thread: "discover",
    layer: "Search and maps",
    detail: "Typed event records feed multi-field filtering, result counts, location lookup, and lazy MapLibre views.",
  },
  {
    thread: "plan",
    layer: "Saved routes",
    detail: "Authenticated saved events and Postgres-backed plans support ordering, arrival times, sharing, and export.",
  },
  {
    thread: "return",
    layer: "Identity and offline",
    detail: "Canonical event keys, share routes, IndexedDB snapshots, service-worker caching, and queued mutations preserve the return path.",
  },
];

const initialThread = "discover";
---

<BaseLayout
  title="Fete Finder Discovery - Owen Abel Amenze"
  description="A case study on Fete Finder's search, maps, saved routes, sharing, and offline product experience."
>
  <article class="case-note" data-case-note data-active-thread={initialThread}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/work">Work</a>
      <span aria-hidden="true">/</span>
      <span>Fete Finder Discovery</span>
    </nav>

    <header class="case-hero">
      <p class="eyebrow">Case study</p>
      <h1>Fete Finder Discovery</h1>
      <p>
        Work on the public surface of a city-wide cultural programme: search,
        filters, maps, event detail routes, and the small pieces of trust that
        make a listing worth sharing under launch traffic that reached 3,000+
        registrations and 50,000+ unique visitors.
      </p>
    </header>

    <dl class="case-meta" aria-label="Case note summary">
      <div>
        <dt>Context</dt>
        <dd>Out Of Office Collective / 2025-26</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Search, maps, saved events, route planning, sharing, offline support</dd>
      </div>
      <div>
        <dt>Link</dt>
        <dd>
          <a href="https://fete.outofofficecollective.co.uk">fete.outofofficecollective.co.uk</a>
        </dd>
      </div>
    </dl>

    <nav class="case-control" aria-label="Case study controls">
      <p>
        <span>Navigate</span>
        <kbd>↑</kbd><kbd>↓</kbd> sections
        <kbd>←</kbd><kbd>→</kbd> threads
        <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> direct
      </p>
      <div>
        {
          threads.map((thread, index) => (
            <button
              type="button"
              data-thread-control={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              [{index + 1}] {thread.label}
            </button>
          ))
        }
      </div>
    </nav>

    <section class="case-section" aria-labelledby="case-tension" data-case-section>
      <div class="case-section-label">
        <h2 id="case-tension">Tension</h2>
        <p>A city-wide programme rarely begins as a tidy plan.</p>
      </div>
      <p>
        Fete de la Musique is not a neat catalogue problem. It is a moving city
        programme: many venues, many tastes, changing details, and users who may
        only know that they want something nearby, free, outside, late, specific,
        or surprising.
      </p>
    </section>

    <section class="case-section" aria-labelledby="case-threads" data-case-section>
      <div class="case-section-label">
        <h2 id="case-threads">Threads</h2>
        <p>Finding an event, making a plan, and keeping it usable.</p>
      </div>
      <div class="case-thread-grid">
        {
          threads.map((thread) => (
            <button
              class="case-thread"
              type="button"
              data-thread={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              <span>{thread.label}</span>
              <small>{thread.tension}</small>
            </button>
          ))
        }
      </div>
    </section>

    <section class="case-section" aria-labelledby="case-owned" data-case-section>
      <div class="case-section-label">
        <h2 id="case-owned">Owned</h2>
        <p>The parts I built across the public journey.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Thread</th>
            <th scope="col">Work</th>
            <th scope="col">Outcome</th>
          </tr>
        </thead>
        <tbody>
          {
            threads.map((thread) => (
              <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
                <td>{thread.label}</td>
                <td>{thread.owned}</td>
                <td>{thread.proof}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section" aria-labelledby="case-mechanism" data-case-section>
      <div class="case-section-label">
        <h2 id="case-mechanism">Mechanism</h2>
        <p>The technical choices beneath the product work.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Layer</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            mechanisms.map((mechanism) => (
              <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
                <td>{mechanism.layer}</td>
                <td>{mechanism.detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section" aria-labelledby="case-reflection" data-case-section>
      <div class="case-section-label">
        <h2 id="case-reflection">Reflection</h2>
        <p>What the project clarified about cultural discovery.</p>
      </div>
      <p>
        The strongest version of the product was not a beautiful list of events.
        It helped people narrow a whole city until a night began to take shape.
      </p>
    </section>

    <RelatedCaseStudies currentHref="/work/fete-finder-discovery" />
  </article>

  <CaseStudyInteractions />
</BaseLayout>
