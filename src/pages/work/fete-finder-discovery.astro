---
import BaseLayout from "../../layouts/BaseLayout.astro";

const threads = [
  {
    key: "search",
    label: "Discovery surface",
    tension: "A large programme needed to feel searchable by half-formed intent: area, date, genre, venue, price, and mood.",
    owned: "Built the event discovery surface around search, filters, result counts, dynamic chips, and clear recovery from over-filtering.",
    proof: "The programme became something people could narrow without needing to understand the whole dataset first.",
  },
  {
    key: "map",
    label: "City context",
    tension: "Discovery was spatial as much as editorial; people needed to understand what was nearby and what was worth crossing Paris for.",
    owned: "Shaped map loading, venue coordinates, location fallbacks, and map/list behaviour so geography supported browsing without blocking it.",
    proof: "The map became an aid to discovery rather than a fragile dependency for the whole experience.",
  },
  {
    key: "share",
    label: "Shareable events",
    tension: "A campaign only travels if individual events can be opened, shared, and trusted after programme edits.",
    owned: "Built stable event identities, share routes, event detail hydration, OG image support, and modal routing around canonical event keys.",
    proof: "Links could survive row order changes and content edits while still resolving into the live event experience.",
  },
];

const mechanisms = [
  {
    thread: "search",
    layer: "Search and filters",
    detail: "Query matching across titles, locations, dates, arrondissements, genres, tags, type, price, nationality, venue type, age, and OOOC picks.",
  },
  {
    thread: "map",
    layer: "Map resilience",
    detail: "Lazy map loading, coordinate enrichment, provider fallbacks, map preference settings, and graceful offline/map-asset failure copy.",
  },
  {
    thread: "share",
    layer: "Event identity",
    detail: "Canonical eventKey lookup with decorative slugs, event modal URL state, detail hydration, and share metadata.",
  },
  {
    thread: "share",
    layer: "Offline detail",
    detail: "IndexedDB event snapshots and service-worker caching for safe event JSON routes after a successful online visit.",
  },
];

const initialThread = "search";
---

<BaseLayout
  title="Fete Finder Discovery - Owen Abel Amenze"
  description="A case study on Fete Finder's public discovery surface, maps, and shareable event routes."
>
  <article class="case-note" data-case-note data-active-thread={initialThread}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/work">Work</a>
      <span aria-hidden="true">/</span>
      <span>Fete Finder Discovery</span>
    </nav>

    <header class="case-hero">
      <p class="eyebrow">Case study</p>
      <h1>Fete Finder Discovery</h1>
      <p>
        Work on the public surface of a city-wide cultural programme: search,
        filters, maps, event detail routes, and the small pieces of trust that
        make a listing worth sharing under launch traffic that reached 3,000+
        registrations and 50,000+ unique visitors.
      </p>
    </header>

    <dl class="case-meta" aria-label="Case note summary">
      <div>
        <dt>Context</dt>
        <dd>Out Of Office Collective / 2025-26</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Search, filters, maps, event identity, share routes, offline fallback</dd>
      </div>
      <div>
        <dt>Link</dt>
        <dd>
          <a href="https://fete.outofofficecollective.co.uk">fete.outofofficecollective.co.uk</a>
        </dd>
      </div>
    </dl>

    <nav class="case-control" aria-label="Case study controls">
      <p>
        <span>Navigate</span>
        <kbd>↑</kbd><kbd>↓</kbd> sections
        <kbd>←</kbd><kbd>→</kbd> threads
        <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> direct
      </p>
      <div>
        {
          threads.map((thread, index) => (
            <button
              type="button"
              data-thread-control={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              [{index + 1}] {thread.label}
            </button>
          ))
        }
      </div>
    </nav>

    <section class="case-section" aria-labelledby="case-tension" data-case-section>
      <div class="case-section-label">
        <h2 id="case-tension">Tension</h2>
        <p>The product problem beneath the work.</p>
      </div>
      <p>
        Fete de la Musique is not a neat catalogue problem. It is a moving city
        programme: many venues, many tastes, changing details, and users who may
        only know that they want something nearby, free, outside, late, specific,
        or surprising.
      </p>
    </section>

    <section class="case-section" aria-labelledby="case-threads" data-case-section>
      <div class="case-section-label">
        <h2 id="case-threads">Threads</h2>
        <p>Three parts of the public discovery experience.</p>
      </div>
      <div class="case-thread-grid">
        {
          threads.map((thread) => (
            <button
              class="case-thread"
              type="button"
              data-thread={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              <span>{thread.label}</span>
              <small>{thread.tension}</small>
            </button>
          ))
        }
      </div>
    </section>

    <section class="case-section" aria-labelledby="case-owned" data-case-section>
      <div class="case-section-label">
        <h2 id="case-owned">Owned</h2>
        <p>What I was responsible for, and what it changed.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Thread</th>
            <th scope="col">Work</th>
            <th scope="col">Signal</th>
          </tr>
        </thead>
        <tbody>
          {
            threads.map((thread) => (
              <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
                <td>{thread.label}</td>
                <td>{thread.owned}</td>
                <td>{thread.proof}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section" aria-labelledby="case-mechanism" data-case-section>
      <div class="case-section-label">
        <h2 id="case-mechanism">Mechanism</h2>
        <p>The technical layers behind those responsibilities.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Layer</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            mechanisms.map((mechanism) => (
              <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
                <td>{mechanism.layer}</td>
                <td>{mechanism.detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section case-flow" aria-labelledby="case-shape" data-case-section>
      <div class="case-section-label">
        <h2 id="case-shape">Shape</h2>
        <p>How the work moved from intent to a usable route.</p>
      </div>
      <ol>
        <li data-thread="search" data-active>A user arrives with a vague cultural intent.</li>
        <li data-thread="search" data-active>Search and filters turn the programme into a smaller set of decisions.</li>
        <li data-thread="map">Map and location cues make the decision feel grounded in the city.</li>
        <li data-thread="share">A stable event route turns a discovery into something shareable.</li>
        <li data-thread="share">The event key keeps that link intact as the programme changes.</li>
      </ol>
    </section>

    <section class="case-section" aria-labelledby="case-reflection" data-case-section>
      <div class="case-section-label">
        <h2 id="case-reflection">Reflection</h2>
        <p>What the project clarified about cultural discovery.</p>
      </div>
      <p>
        The strongest version of the product was not a beautiful list of events.
        It was a surface that helped people form a plan from uncertainty:
        narrowing the city, trusting the detail, and sending someone else a link
        that still worked after the data moved.
      </p>
    </section>

    <section class="case-section related-case" aria-labelledby="related-case">
      <div class="case-section-label">
        <h2 id="related-case">Related</h2>
        <p>The operational note behind the public launch.</p>
      </div>
      <p>
        <a href="/work/fete-finder-operations">Fete Finder: admin, data, and launch operations</a>
      </p>
    </section>
  </article>

  <script>
    const caseNote = document.querySelector("[data-case-note]");
    const controls = Array.from(caseNote.querySelectorAll(".case-thread[data-thread]"));
    const threadControls = Array.from(caseNote.querySelectorAll("[data-thread-control]"));
    const related = caseNote.querySelectorAll("[data-thread]");
    const sections = Array.from(caseNote.querySelectorAll("[data-case-section]"));

    const applyThread = (key) => {
      caseNote.dataset.activeThread = key ?? "";

      related.forEach((node) => {
        const active = Boolean(key) && node.dataset.thread === key;
        node.toggleAttribute("data-active", active);

        if (node.matches(".case-thread")) {
          node.setAttribute("aria-pressed", String(active));
        }
      });

      threadControls.forEach((control) => {
        const active = Boolean(key) && control.dataset.threadControl === key;
        control.toggleAttribute("data-active", active);
        control.setAttribute("aria-pressed", String(active));
      });
    };

    const toggleThread = (key) => {
      applyThread(caseNote.dataset.activeThread === key ? undefined : key);
    };

    const activeThreadIndex = () => {
      const index = controls.findIndex((control) => control.dataset.thread === caseNote.dataset.activeThread);
      return index < 0 ? 0 : index;
    };

    const moveThread = (amount) => {
      const nextControl = controls[(activeThreadIndex() + amount + controls.length) % controls.length];

      nextControl.focus({ preventScroll: true });
      applyThread(nextControl.dataset.thread);
    };

    const currentSectionIndex = () => {
      const viewportAnchor = window.scrollY + window.innerHeight * 0.28;

      for (let index = sections.length - 1; index >= 0; index -= 1) {
        if (sections[index].offsetTop <= viewportAnchor) {
          return index;
        }
      }

      return -1;
    };

    const moveSection = (amount) => {
      const currentIndex = currentSectionIndex();
      const firstSectionTop = sections[0].offsetTop;
      const isNearFirstSection = window.scrollY <= firstSectionTop;

      if (amount < 0 && (currentIndex <= 0 || isNearFirstSection)) {
        window.scrollTo({
          top: Math.max(0, caseNote.offsetTop - 18),
          behavior: "smooth",
        });
        return;
      }

      const nextIndex = Math.min(Math.max(currentIndex + amount, 0), sections.length - 1);
      sections[nextIndex].scrollIntoView({ behavior: "smooth", block: "start" });
    };

    controls.forEach((control, index) => {
      control.addEventListener("click", () => toggleThread(control.dataset.thread));
      control.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];

        if (!keys.includes(event.key)) {
          return;
        }

        event.preventDefault();

        const nextIndex =
          {
            ArrowRight: (index + 1) % controls.length,
            ArrowLeft: (index - 1 + controls.length) % controls.length,
            Home: 0,
            End: controls.length - 1,
          }[event.key] ?? index;
        const nextControl = controls[nextIndex];

        nextControl.focus({ preventScroll: true });
        applyThread(nextControl.dataset.thread);
      });
    });

    threadControls.forEach((control) => {
      control.addEventListener("click", () => {
        applyThread(control.dataset.threadControl);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.defaultPrevented || event.metaKey || event.altKey || event.ctrlKey) {
        return;
      }

      if (!caseNote.contains(event.target) && event.target !== document.body) {
        return;
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();
        moveSection(1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        moveSection(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        moveThread(1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        moveThread(-1);
      } else if (["1", "2", "3"].includes(event.key)) {
        event.preventDefault();
        applyThread(controls[Number(event.key) - 1].dataset.thread);
      } else if (event.key === "Escape") {
        applyThread();
      }
    });
  </script>
</BaseLayout>
