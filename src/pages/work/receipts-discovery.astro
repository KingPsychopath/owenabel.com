---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedCaseStudies from "../../components/RelatedCaseStudies.astro";

const threads = [
  {
    key: "evidence",
    label: "Evidence model",
    tension: "Beauty discovery often asks users to trust claims without showing where those claims came from.",
    owned: "Shaped a trust model where provider capability comes from structured reviews, portfolio media, tag confirmations, and visible evidence.",
    proof: "Discovery can explain why a provider appears instead of relying on empty popularity or self-claimed expertise.",
  },
  {
    key: "taxonomy",
    label: "Taxonomy policy",
    tension: "Hair and beauty language is messy, personal, and culturally specific; AI labels can easily overclaim.",
    owned: "Defined taxonomy, tagging policy, and discovery facets so image analysis stays inside visually reliable buckets and user language maps safely at query time.",
    proof: "The product can use AI for visual evidence without pretending to infer traits that belong to profile or behaviour.",
  },
  {
    key: "ranking",
    label: "Deterministic ranking",
    tension: "Search needed to balance text relevance with verified capability, trust, feedback, and quality signals.",
    owned: "Built the search model around Postgres projections, full-text search, trigram matching, taxonomy mapping, and deterministic reranking.",
    proof: "Ranking becomes a product contract: structured evidence beats text-heavy matches when trust should matter more.",
  },
];

const mechanisms = [
  {
    thread: "evidence",
    layer: "Feedback loop",
    detail: "Review/portfolio scopes persist accepted, rejected, and manual tag feedback into consensus and training data.",
  },
  {
    thread: "taxonomy",
    layer: "Tagging policy",
    detail: "AI outputs visually reliable texture buckets; profile and behaviour signals handle traits that should not be image-inferred.",
  },
  {
    thread: "taxonomy",
    layer: "Manual language",
    detail: "Aliases and fuzzy/manual mapping let user language resolve into canonical taxonomy without making AI labels over-specific.",
  },
  {
    thread: "ranking",
    layer: "Retrieval",
    detail: "Postgres search projection combines structured tags, generated tsvectors, full-text rank, and trigram-style loose matching.",
  },
  {
    thread: "ranking",
    layer: "Rerank",
    detail: "Deterministic ranker balances taxonomy evidence, trust multipliers, review quality, profile affinity, feedback, and text relevance.",
  },
];

const initialThread = "evidence";
---

<BaseLayout
  title="Receipts Discovery - Owen Abel Amenze"
  description="A case study on Receipts' trust-first discovery, taxonomy policy, and evidence-backed ranking."
>
  <article class="case-note" data-case-note data-active-thread={initialThread}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/work">Work</a>
      <span aria-hidden="true">/</span>
      <span>Receipts Discovery</span>
    </nav>

    <header class="case-hero">
      <p class="eyebrow">Case study</p>
      <h1>Receipts Discovery</h1>
      <p>
        Work on a trust-first beauty discovery system where search, image
        evidence, taxonomy policy, and ranking all need to show their working.
      </p>
    </header>

    <dl class="case-meta" aria-label="Case note summary">
      <div>
        <dt>Context</dt>
        <dd>Founder / 2026</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Trust semantics, taxonomy, AI policy gates, Postgres search, ranking</dd>
      </div>
      <div>
        <dt>Link</dt>
        <dd>
          <a href="https://receipts.beauty">receipts.beauty</a>
        </dd>
      </div>
    </dl>

    <nav class="case-control" aria-label="Case study controls">
      <p>
        <span>Navigate</span>
        <kbd>↑</kbd><kbd>↓</kbd> sections
        <kbd>←</kbd><kbd>→</kbd> threads
        <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> direct
      </p>
      <div>
        {
          threads.map((thread, index) => (
            <button
              type="button"
              data-thread-control={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              [{index + 1}] {thread.label}
            </button>
          ))
        }
      </div>
    </nav>

    <section class="case-section" aria-labelledby="case-tension" data-case-section>
      <div class="case-section-label">
        <h2 id="case-tension">Tension</h2>
        <p>The product problem beneath the work.</p>
      </div>
      <p>
        Beauty discovery is full of high-stakes personal decisions and weak
        evidence. A provider can look relevant because their text is good, their
        tags are broad, or their profile is polished. Receipts needed a ranking
        model that could prefer proof over performance.
      </p>
    </section>

    <section class="case-section" aria-labelledby="case-threads" data-case-section>
      <div class="case-section-label">
        <h2 id="case-threads">Threads</h2>
        <p>Three product contracts behind trustworthy discovery.</p>
      </div>
      <div class="case-thread-grid">
        {
          threads.map((thread) => (
            <button
              class="case-thread"
              type="button"
              data-thread={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              <span>{thread.label}</span>
              <small>{thread.tension}</small>
            </button>
          ))
        }
      </div>
    </section>

    <section class="case-section" aria-labelledby="case-owned" data-case-section>
      <div class="case-section-label">
        <h2 id="case-owned">Owned</h2>
        <p>What I was responsible for, and what it changed.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Thread</th>
            <th scope="col">Work</th>
            <th scope="col">Signal</th>
          </tr>
        </thead>
        <tbody>
          {
            threads.map((thread) => (
              <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
                <td>{thread.label}</td>
                <td>{thread.owned}</td>
                <td>{thread.proof}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section" aria-labelledby="case-mechanism" data-case-section>
      <div class="case-section-label">
        <h2 id="case-mechanism">Mechanism</h2>
        <p>The technical layers behind those responsibilities.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Layer</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            mechanisms.map((mechanism) => (
              <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
                <td>{mechanism.layer}</td>
                <td>{mechanism.detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section case-flow" aria-labelledby="case-shape" data-case-section>
      <div class="case-section-label">
        <h2 id="case-shape">Shape</h2>
        <p>How a search result becomes accountable.</p>
      </div>
      <ol>
        <li data-thread="evidence" data-active>A user or provider contributes review or portfolio evidence.</li>
        <li data-thread="taxonomy">AI suggestions are filtered through tagging policy before they can matter.</li>
        <li data-thread="taxonomy">Manual language maps into canonical taxonomy when it is reliable enough.</li>
        <li data-thread="ranking">Search retrieves candidates through structured tags and messy text.</li>
        <li data-thread="ranking">Ranking balances relevance with trust, feedback, and quality signals.</li>
      </ol>
    </section>

    <section class="case-section" aria-labelledby="case-reflection" data-case-section>
      <div class="case-section-label">
        <h2 id="case-reflection">Reflection</h2>
        <p>What the project clarified about trust.</p>
      </div>
      <p>
        The product is strongest when trust is treated as infrastructure, not
        copy. If the system can say why a provider appears, what evidence
        supports it, and where the model refused to overclaim, discovery starts
        to feel useful rather than merely persuasive.
      </p>
    </section>

    <RelatedCaseStudies currentHref="/work/receipts-discovery" />
  </article>

  <script>
    const caseNote = document.querySelector("[data-case-note]");
    const controls = Array.from(caseNote.querySelectorAll(".case-thread[data-thread]"));
    const threadControls = Array.from(caseNote.querySelectorAll("[data-thread-control]"));
    const related = caseNote.querySelectorAll("[data-thread]");
    const sections = Array.from(caseNote.querySelectorAll("[data-case-section]"));

    const applyThread = (key) => {
      caseNote.dataset.activeThread = key ?? "";

      related.forEach((node) => {
        const active = Boolean(key) && node.dataset.thread === key;
        node.toggleAttribute("data-active", active);

        if (node.matches(".case-thread")) {
          node.setAttribute("aria-pressed", String(active));
        }
      });

      threadControls.forEach((control) => {
        const active = Boolean(key) && control.dataset.threadControl === key;
        control.toggleAttribute("data-active", active);
        control.setAttribute("aria-pressed", String(active));
      });
    };

    const toggleThread = (key) => {
      applyThread(caseNote.dataset.activeThread === key ? undefined : key);
    };

    const activeThreadIndex = () => {
      const index = controls.findIndex((control) => control.dataset.thread === caseNote.dataset.activeThread);
      return index < 0 ? 0 : index;
    };

    const moveThread = (amount) => {
      const nextControl = controls[(activeThreadIndex() + amount + controls.length) % controls.length];

      nextControl.focus({ preventScroll: true });
      applyThread(nextControl.dataset.thread);
    };

    const currentSectionIndex = () => {
      const viewportAnchor = window.scrollY + window.innerHeight * 0.28;

      for (let index = sections.length - 1; index >= 0; index -= 1) {
        if (sections[index].offsetTop <= viewportAnchor) {
          return index;
        }
      }

      return -1;
    };

    const moveSection = (amount) => {
      const currentIndex = currentSectionIndex();
      const firstSectionTop = sections[0].offsetTop;
      const isNearFirstSection = window.scrollY <= firstSectionTop;

      if (amount < 0 && (currentIndex <= 0 || isNearFirstSection)) {
        window.scrollTo({
          top: Math.max(0, caseNote.offsetTop - 18),
          behavior: "smooth",
        });
        return;
      }

      const nextIndex = Math.min(Math.max(currentIndex + amount, 0), sections.length - 1);
      sections[nextIndex].scrollIntoView({ behavior: "smooth", block: "start" });
    };

    controls.forEach((control, index) => {
      control.addEventListener("click", () => toggleThread(control.dataset.thread));
      control.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];

        if (!keys.includes(event.key)) {
          return;
        }

        event.preventDefault();

        const nextIndex =
          {
            ArrowRight: (index + 1) % controls.length,
            ArrowLeft: (index - 1 + controls.length) % controls.length,
            Home: 0,
            End: controls.length - 1,
          }[event.key] ?? index;
        const nextControl = controls[nextIndex];

        nextControl.focus({ preventScroll: true });
        applyThread(nextControl.dataset.thread);
      });
    });

    threadControls.forEach((control) => {
      control.addEventListener("click", () => {
        applyThread(control.dataset.threadControl);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.defaultPrevented || event.metaKey || event.altKey || event.ctrlKey) {
        return;
      }

      if (!caseNote.contains(event.target) && event.target !== document.body) {
        return;
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();
        moveSection(1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        moveSection(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        moveThread(1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        moveThread(-1);
      } else if (["1", "2", "3"].includes(event.key)) {
        event.preventDefault();
        applyThread(controls[Number(event.key) - 1].dataset.thread);
      } else if (event.key === "Escape") {
        applyThread();
      }
    });
  </script>
</BaseLayout>
