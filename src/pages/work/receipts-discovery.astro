---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaseStudySection from "../../components/CaseStudySection.astro";

const threads = [
  {
    key: "evidence",
    label: "Evidence",
    tension: "Beauty discovery often asks users to trust claims without showing where those claims came from.",
    owned: "Separated claims, reviews, media confirmations, AI suggestions, and moderator decisions.",
    proof: "Each result can show what is proven and by whom.",
  },
  {
    key: "intent",
    label: "Search intent",
    tension: "Hair and beauty language is messy, personal, and culturally specific; people also search with images, places, and saved looks.",
    owned: "Let people search with words, images, places, and lookbooks without turning intent into proof.",
    proof: "Visual similarity remains a lead, not a claim.",
  },
  {
    key: "ranking",
    label: "Ranking and explanation",
    tension: "A relevant match is not always a proven one.",
    owned: "Balanced relevance, evidence, review quality, location, and visual likeness.",
    proof: "Each result explains why it appeared and how strong its evidence is.",
  },
];

const mechanisms = [
  {
    thread: "evidence",
    layer: "Evidence model",
    detail: "Append-only events keep provider claims, verified reviews, media confirmations, corrections, and moderation distinct.",
  },
  {
    thread: "intent",
    layer: "Search context",
    detail: "Stable intent and lookbook IDs carry image, taxonomy, location, and provenance without turning intent into evidence.",
  },
  {
    thread: "ranking",
    layer: "Retrieval and rank",
    detail: "Postgres text search and private embeddings feed a deterministic ranker that returns evidence level and admission reason.",
  },
];

const initialThread = "intent";
---

<CaseStudyLayout
  title="Receipts Discovery"
  description="A case study on Receipts' evidence model, multimodal search, taxonomy policy, and explainable ranking."
  threads={threads}
  initialThread={initialThread}
>
  <p slot="intro">
    Work on a trust-first beauty discovery system where search, image
    evidence, taxonomy policy, and ranking all need to show their working.
  </p>

  <dl slot="meta" class="case-meta" aria-label="Case note summary">
    <div>
      <dt>Context</dt>
      <dd>Founder / 2026</dd>
    </div>
    <div>
      <dt>Focus</dt>
      <dd>Evidence, taxonomy, visual intent, lookbooks, Postgres search, ranking</dd>
    </div>
    <div>
      <dt>Link</dt>
      <dd>
        <a href="https://receipts.beauty">receipts.beauty</a>
      </dd>
    </div>
  </dl>

  <CaseStudySection
    id="case-tension"
    title="Tension"
    summary="Looking right and being proven are different things."
  >
    <p>
      Beauty discovery is full of high-stakes personal decisions and weak
      evidence. A provider can look relevant because their text is good, their
      tags are broad, or their profile is polished. Receipts needed a ranking
      model that could prefer proof over performance.
    </p>
  </CaseStudySection>

  <CaseStudySection
    id="case-threads"
    title="Threads"
    summary="What counts as proof, how intent enters, and why a result appears."
  >
    <div class="case-thread-grid">
      {
        threads.map((thread) => (
          <button
            class="case-thread"
            type="button"
            data-thread={thread.key}
            data-active={thread.key === initialThread ? true : undefined}
            aria-pressed={thread.key === initialThread ? "true" : "false"}
          >
            <span>{thread.label}</span>
            <small>{thread.tension}</small>
          </button>
        ))
      }
    </div>
  </CaseStudySection>

  <CaseStudySection
    id="case-owned"
    title="Owned"
    summary="The product rules and systems I shaped."
  >
    <table class="case-ledger">
      <thead>
        <tr>
          <th scope="col">Thread</th>
          <th scope="col">Work</th>
          <th scope="col">Outcome</th>
        </tr>
      </thead>
      <tbody>
        {
          threads.map((thread) => (
            <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
              <td>{thread.label}</td>
              <td>{thread.owned}</td>
              <td>{thread.proof}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </CaseStudySection>

  <CaseStudySection
    id="case-mechanism"
    title="Mechanism"
    summary="The technical choices beneath discovery."
  >
    <table class="case-ledger">
      <thead>
        <tr>
          <th scope="col">Layer</th>
          <th scope="col">Detail</th>
        </tr>
      </thead>
      <tbody>
        {
          mechanisms.map((mechanism) => (
            <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
              <td>{mechanism.layer}</td>
              <td>{mechanism.detail}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </CaseStudySection>

  <CaseStudySection
    id="case-reflection"
    title="Reflection"
    summary="What the project clarified about trust."
  >
    <p>
      The product is strongest when trust is treated as infrastructure, not
      copy. If the system can say why a provider appears, what evidence
      supports it, and where the model refused to overclaim, discovery starts
      to feel useful rather than merely persuasive.
    </p>
  </CaseStudySection>
</CaseStudyLayout>
