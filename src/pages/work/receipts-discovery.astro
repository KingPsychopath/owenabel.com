---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaseStudySection from "../../components/CaseStudySection.astro";

const threads = [
  {
    key: "evidence",
    label: "Name the source",
    owned: "Built distinctions between provider claims, reviews, media evidence, and moderation.",
    enables: "A result can identify the kind of support behind a match."
  },
  {
    key: "intent",
    label: "Understand the request",
    owned: "Built search around words, images, location, and saved looks.",
    enables: "People can express what they want without needing the exact label used by a provider."
  },
  {
    key: "ranking",
    label: "Explain the match",
    owned: "Built ranking and result explanations that carry the source and reason for a match.",
    enables: "Visual similarity can be labelled separately from support in a portfolio or review."
  }
];
const mechanisms = [
  {
    thread: "evidence",
    layer: "Keep a claim attached to its source",
    detail: "The result model carries an evidence source and an admission reason. Those distinctions survive into the public explanation instead of being collapsed into a single confidence score."
  },
  {
    thread: "intent",
    layer: "Treat an image as a search clue",
    detail: "A reference image can express a desired look. Similarity helps find candidates, but it does not by itself establish that a provider has done that work."
  },
  {
    thread: "ranking",
    layer: "Return the explanation with the result",
    detail: "Search returns labels for different match paths, including visual similarity and portfolio or review support. The interface does not need to invent an explanation after ranking."
  }
];
const initialThread = "evidence";
---

<CaseStudyLayout title="Receipts Discovery" description="Beauty search that distinguishes provider claims, reviews, and visual similarity." threads={threads} initialThread={initialThread}>
  <p slot="intro">Choosing a beauty provider means judging whether their work fits what you want. Receipts lets people search with words or images and see what sits behind a recommendation.</p>
  <dl slot="meta" class="case-meta" aria-label="Case study summary">
    <div><dt>Context</dt><dd>Receipts / Founder / 2026</dd></div>
    <div><dt>Focus</dt><dd>Beauty discovery, reviews, visual search, ranking</dd></div>
    <div><dt>Project</dt><dd><a href="https://receipts.beauty">receipts.beauty</a></dd></div>
  </dl>

  <CaseStudySection id="case-problem" title="Problem">
    <p>A polished profile, a similar-looking image, and a review from a client tell you different things. Search needs to use those signals without presenting them as interchangeable evidence of what a provider can do.</p>
  </CaseStudySection>

  <CaseStudySection id="case-contribution" title="My contribution">
    <table class="case-ledger">
      <thead><tr><th scope="col">Area</th><th scope="col">What I built and why</th></tr></thead>
      <tbody>{threads.map((thread) => (
        <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
          <th scope="row">{thread.label}</th><td><p>{thread.owned}</p><p>{thread.enables}</p></td>
        </tr>
      ))}</tbody>
    </table>
  </CaseStudySection>

  <CaseStudySection id="case-decisions" title="Decisions">
    <div class="case-prose">
      <table class="case-ledger">
        <thead><tr><th scope="col">Choice</th><th scope="col">Why it matters</th></tr></thead>
        <tbody>{mechanisms.map((mechanism) => (
          <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
            <th scope="row">{mechanism.layer}</th><td>{mechanism.detail}</td>
          </tr>
        ))}</tbody>
      </table>
      <figure class="case-diagram"><figcaption>Three signals, three meanings</figcaption><ol>
<li><strong>Provider claim</strong><span>What the provider says they offer.</span></li>
<li><strong>Portfolio or review</strong><span>Work or an account of an experience that supports the match.</span></li>
<li><strong>Visual similarity</strong><span>A reason to look closer, with its own label.</span></li>
</ol></figure>
    </div>
  </CaseStudySection>

  <CaseStudySection id="case-result" title="What it enables">
    <div class="case-prose"><p>Receipts explains why a provider appears in search and identifies the source behind the match. People can distinguish a visual resemblance from support in a portfolio or client review when comparing providers.</p></div>
  </CaseStudySection>

  <CaseStudySection id="case-lesson" title="Lesson">
    <p>A ranking score is useful to a retrieval system, but people need an explanation they can judge. Keeping the source visible forces the product to be precise about what it knows and what it is only suggesting.</p>
  </CaseStudySection>
</CaseStudyLayout>
