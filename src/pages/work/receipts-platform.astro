---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaseStudySection from "../../components/CaseStudySection.astro";

const threads = [
  {
    key: "boundaries",
    label: "Runtime boundaries",
    tension: "Product rules could not belong separately to web routes, API adapters, workers, and database queries.",
    owned: "Moved product rules behind one generated API contract and a Go backend.",
    proof: "Web and future clients can use the same behaviour.",
  },
  {
    key: "jobs",
    label: "Durable workflows",
    tension: "Media, AI analysis, and search indexing outlive a request and fail in different ways.",
    owned: "Made long-running work retryable, visible, and recoverable.",
    proof: "Failures no longer disappear inside a request.",
  },
  {
    key: "ops",
    label: "Control and release",
    tension: "Speed could not come at the cost of unclear permissions, unsafe migrations, or fragile releases.",
    owned: "Turned sensitive changes and releases into checked paths.",
    proof: "Contract, migration, and release drift can fail before production.",
  },
];

const mechanisms = [
  {
    thread: "boundaries",
    layer: "Contracts",
    detail: "Protobuf definitions generate ConnectRPC clients while Go capability packages own validation, policy, persistence, and projections.",
  },
  {
    thread: "jobs",
    layer: "Background work",
    detail: "Postgres queues give media, AI, embeddings, indexing, notifications, and cleanup retryable state and visible status.",
  },
  {
    thread: "ops",
    layer: "Control plane",
    detail: "OIDC sessions, permissions, audit events, health checks, architecture linting, migration checks, and release smokes guard production.",
  },
];

const initialThread = "boundaries";
---

<CaseStudyLayout
  title="Receipts Platform"
  description="A case study on Receipts' generated API contracts, Go backend, Postgres workflows, media jobs, and release controls."
  threads={threads}
  initialThread={initialThread}
>
  <p slot="intro">
    Work on the system underneath a trust-first product: typed contracts,
    package boundaries, background jobs, and operational controls that make
    change possible.
  </p>

  <dl slot="meta" class="case-meta" aria-label="Case study summary">
    <div>
      <dt>Context</dt>
      <dd>Founder / 2026</dd>
    </div>
    <div>
      <dt>Focus</dt>
      <dd>TanStack Start, Go, ConnectRPC, Protobuf, Postgres, workers, Railway</dd>
    </div>
    <div>
      <dt>Link</dt>
      <dd>
        <a href="https://receipts.beauty">receipts.beauty</a>
      </dd>
    </div>
  </dl>

  <CaseStudySection
    id="case-tension"
    title="Tension"
    summary="The product grew faster than one application layer could own."
  >
    <p>
      Receipts now spans search, reviews, provider workspaces, lookbooks,
      messaging, media, AI, and moderation. The platform needed to keep those
      capabilities changeable without letting routes, jobs, or database code
      become the owners of product rules.
    </p>
  </CaseStudySection>

  <CaseStudySection
    id="case-threads"
    title="Threads"
    summary="Where behaviour lives, how work survives, and how change ships."
  >
    <div class="case-thread-grid">
      {
        threads.map((thread) => (
          <button
            class="case-thread"
            type="button"
            data-thread={thread.key}
            data-active={thread.key === initialThread ? true : undefined}
            aria-pressed={thread.key === initialThread ? "true" : "false"}
          >
            <span>{thread.label}</span>
            <small>{thread.tension}</small>
          </button>
        ))
      }
    </div>
  </CaseStudySection>

  <CaseStudySection
    id="case-owned"
    title="Owned"
    summary="The platform boundaries and operating paths I shaped."
  >
    <table class="case-ledger">
      <thead>
        <tr>
          <th scope="col">Thread</th>
          <th scope="col">Work</th>
          <th scope="col">Outcome</th>
        </tr>
      </thead>
      <tbody>
        {
          threads.map((thread) => (
            <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
              <td>{thread.label}</td>
              <td>{thread.owned}</td>
              <td>{thread.proof}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </CaseStudySection>

  <CaseStudySection
    id="case-mechanism"
    title="Mechanism"
    summary="The technical choices beneath the platform."
  >
    <table class="case-ledger">
      <thead>
        <tr>
          <th scope="col">Layer</th>
          <th scope="col">Detail</th>
        </tr>
      </thead>
      <tbody>
        {
          mechanisms.map((mechanism) => (
            <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
              <td>{mechanism.layer}</td>
              <td>{mechanism.detail}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </CaseStudySection>

  <CaseStudySection
    id="case-reflection"
    title="Reflection"
    summary="What the project clarified about platform work."
  >
    <p>
      The platform is part of the product. A trust product cannot explain
      itself if its own internals are tangled, so the architecture has to make
      responsibility visible: where data enters, where work waits, where it
      retries, and where an operator can see what happened.
    </p>
  </CaseStudySection>
</CaseStudyLayout>
