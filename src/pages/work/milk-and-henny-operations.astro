---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaseStudySection from "../../components/CaseStudySection.astro";

const threads = [
  {
    key: "event",
    label: "Event operations",
    tension: "A party site has to work before, during, and after the event: entry, voting, photos, and the inevitable sharing afterwards.",
    owned: "Built the party hub, guest-list check-in, admin management, best-dressed voting, vote-code controls, multi-device sync, and album download paths.",
    proof: "The site supports the whole event loop: guests arrive, participate, find photos, and leave with a way to get what they need.",
  },
  {
    key: "transfers",
    label: "Photo sharing",
    tension: "Sending hundreds of photos through DMs or temporary transfer links does not scale socially, financially, or aesthetically.",
    owned: "Built private transfer links, R2 storage, presigned uploads, delete tokens, media previews, optimized galleries, and batch download paths.",
    proof: "People can browse and download their own photos from an owned surface instead of repeatedly asking for files after the event.",
  },
  {
    key: "control",
    label: "Operational control",
    tension: "A cheap personal platform still needs real controls when it handles private links, large media, and live event traffic.",
    owned: "Implemented httpOnly role cookies, token revocation/versioning, admin step-up, cron cleanup, R2 lifecycle guidance, worker fallbacks, and CLI diagnostics.",
    proof: "The archive can stay inexpensive and recoverable: sessions can be revoked, files can expire, credentials can rotate, and costs have guardrails.",
  },
];

const mechanisms = [
  {
    thread: "event",
    layer: "Guest list",
    detail: "Door-staff check-in uses server-readable auth, optimistic UI, multi-device polling, CSV import, plus-one handling, and conservative fetch gaps.",
  },
  {
    thread: "event",
    layer: "Best dressed",
    detail: "Voting uses staff-minted one-time codes, optional voting windows, per-device identity, server validation against the guest list, and admin resets.",
  },
  {
    thread: "transfers",
    layer: "Upload path",
    detail: "Browser uploads use presigned PUT URLs so large photo and video files go directly to Cloudflare R2 instead of through serverless request bodies.",
  },
  {
    thread: "transfers",
    layer: "Lifecycle",
    detail: "Transfer metadata lives in Redis with TTL, pages are noindexed, delete tokens are separate from recipient links, and cron/R2 lifecycle cleanup catches residue.",
  },
  {
    thread: "transfers",
    layer: "Heavy media",
    detail: "Hybrid processing handles RAW previews, video posters, browser HEIC/HIF conversion, and ZIP fallback for multi-file downloads.",
  },
  {
    thread: "control",
    layer: "Auth model",
    detail: "Role JWTs live in httpOnly cookies; API bearer auth remains available for CLI and tools; admin actions use step-up tokens and revocation checks.",
  },
  {
    thread: "control",
    layer: "Cost guardrails",
    detail: "CDN caching, direct R2 media delivery, polling budgets, retry rules, rate limits, and documented rotation paths reduce expensive surprises.",
  },
];

const initialThread = "event";
---

<CaseStudyLayout
  title="Milk & Henny Sharing"
  description="A case study on Milk & Henny's photo sharing, private transfers, auth model, and event tools."
  threads={threads}
  initialThread={initialThread}
>
  <p slot="intro">
    Work on the tools around the archive: event-night check-in, voting,
    uploads, private transfers, downloads, auth, cleanup, and cost controls.
  </p>

  <dl slot="meta" class="case-meta" aria-label="Case study summary">
    <div>
      <dt>Context</dt>
      <dd>Personal platform / 2025</dd>
    </div>
    <div>
      <dt>Focus</dt>
      <dd>Photo sharing, event tooling, private transfers, auth, R2, Redis/KV</dd>
    </div>
    <div>
      <dt>Link</dt>
      <dd>
        <a href="https://milkandhenny.com">milkandhenny.com</a>
      </dd>
    </div>
  </dl>

  <CaseStudySection
    id="case-tension"
    title="Tension"
    summary="The product problem beneath the work."
  >
    <p>
      The product came from a simple repeated friction: I would take photos
      at parties, while travelling, and on film/digital cameras, then people
      would ask for them afterwards. Milk & Henny makes that exchange cleaner:
      an event can have tools, a gallery can have filters and downloads, and
      large media can stay cheap instead of becoming a chain of temporary
      transfer links.
    </p>
  </CaseStudySection>

  <CaseStudySection
    id="case-threads"
    title="Threads"
    summary="Three contracts behind sharing without the chase."
  >
    <div class="case-thread-grid">
      {
        threads.map((thread) => (
          <button
            class="case-thread"
            type="button"
            data-thread={thread.key}
            data-active={thread.key === initialThread ? true : undefined}
            aria-pressed={thread.key === initialThread ? "true" : "false"}
          >
            <span>{thread.label}</span>
            <small>{thread.tension}</small>
          </button>
        ))
      }
    </div>
  </CaseStudySection>

  <CaseStudySection
    id="case-owned"
    title="Owned"
    summary="What I was responsible for, and what it changed."
  >
    <table class="case-ledger">
      <thead>
        <tr>
          <th scope="col">Thread</th>
          <th scope="col">Work</th>
          <th scope="col">Signal</th>
        </tr>
      </thead>
      <tbody>
        {
          threads.map((thread) => (
            <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
              <td>{thread.label}</td>
              <td>{thread.owned}</td>
              <td>{thread.proof}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </CaseStudySection>

  <CaseStudySection
    id="case-mechanism"
    title="Mechanism"
    summary="The technical layers behind those responsibilities."
  >
    <table class="case-ledger">
      <thead>
        <tr>
          <th scope="col">Layer</th>
          <th scope="col">Detail</th>
        </tr>
      </thead>
      <tbody>
        {
          mechanisms.map((mechanism) => (
            <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
              <td>{mechanism.layer}</td>
              <td>{mechanism.detail}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </CaseStudySection>

  <CaseStudySection
    id="case-shape"
    title="Shape"
    summary="How event media becomes self-serve."
    class="case-flow"
  >
    <ol>
      <li data-thread="event" data-active>Event tools define the role first: guest, staff, or admin.</li>
      <li data-thread="event">Live state stays lightweight so check-in and voting remain usable during the night.</li>
      <li data-thread="transfers">Uploads go straight to R2 while metadata records expiry, ownership, and deletion paths.</li>
      <li data-thread="transfers">Galleries and transfer pages expose previews, filters, sorting, and downloads so recipients can self-serve.</li>
      <li data-thread="control">Auth, cleanup, budgets, and rate limits keep the archive private, cheap, and recoverable.</li>
    </ol>
  </CaseStudySection>

  <CaseStudySection
    id="case-reflection"
    title="Reflection"
    summary="What the project clarified about sharing."
  >
    <p>
      The nicest sharing experience is often the one where nobody has to ask
      twice. People can find themselves, choose the quality they need, and
      download from a place that feels like mine rather than a temporary
      workaround.
    </p>
  </CaseStudySection>
</CaseStudyLayout>
