---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyInteractions from "../../components/CaseStudyInteractions.astro";
import RelatedCaseStudies from "../../components/RelatedCaseStudies.astro";

const threads = [
  {
    key: "data",
    label: "Programme data",
    tension: "The programme changed daily and still had to stay publishable.",
    owned: "Turned programme edits into a safe publish-and-recover workflow.",
    proof: "The public site stayed usable when live data needed repair.",
  },
  {
    key: "audience",
    label: "Audience operations",
    tension: "People did more than browse: they registered, submitted events, saved plans, and exchanged tickets.",
    owned: "Built registration, submission moderation, saved-plan, and ticket-exchange tools.",
    proof: "People could contribute events, plan a night, and find or pass on tickets.",
  },
  {
    key: "partners",
    label: "Partner operations",
    tension: "Paid placements needed to be scheduled, measured, and reported without distorting editorial discovery.",
    owned: "Built promoted-event scheduling, partner activation, performance reports, and exports.",
    proof: "Partners could see what their campaign delivered without changing organic discovery.",
  },
];

const mechanisms = [
  {
    thread: "data",
    layer: "Publishing",
    detail: "Postgres event storage, validation, revision history, backups, CSV fallback, and revalidation keep edits recoverable.",
  },
  {
    thread: "audience",
    layer: "Audience state",
    detail: "Public sessions connect users to submissions, saved events, plans, preferences, notices, and ticket exchange.",
  },
  {
    thread: "partners",
    layer: "Partner reporting",
    detail: "Promoted schedules, Stripe activations, first-party engagement, tokenized reports, and CSV exports close the campaign loop.",
  },
];

const initialThread = "data";
---

<BaseLayout
  title="Fete Finder Operations - Owen Abel Amenze"
  description="A case study on Fete Finder's programme data, audience operations, partner reporting, launch controls, and seasonal lifecycle."
>
  <article class="case-note" data-case-note data-active-thread={initialThread}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/work">Work</a>
      <span aria-hidden="true">/</span>
      <span>Fete Finder Operations</span>
    </nav>

    <header class="case-hero">
      <p class="eyebrow">Case study</p>
      <h1>Fete Finder Operations</h1>
      <p>
        The work that kept the programme publishable, supported its audience,
        and carried it through launch into archive.
      </p>
    </header>

    <dl class="case-meta" aria-label="Case note summary">
      <div>
        <dt>Context</dt>
        <dd>Out Of Office Collective / 2025-26</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Publishing, audience workflows, partner reporting, recovery, archive</dd>
      </div>
      <div>
        <dt>Link</dt>
        <dd>
          <a href="https://fete.outofofficecollective.co.uk">fete.outofofficecollective.co.uk</a>
        </dd>
      </div>
    </dl>

    <nav class="case-control" aria-label="Case study controls">
      <p>
        <span>Navigate</span>
        <kbd>↑</kbd><kbd>↓</kbd> sections
        <kbd>←</kbd><kbd>→</kbd> threads
        <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> direct
      </p>
      <div>
        {
          threads.map((thread, index) => (
            <button
              type="button"
              data-thread-control={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              [{index + 1}] {thread.label}
            </button>
          ))
        }
      </div>
    </nav>

    <section class="case-section" aria-labelledby="case-tension" data-case-section>
      <div class="case-section-label">
        <h2 id="case-tension">Tension</h2>
        <p>The programme kept moving after the code shipped.</p>
      </div>
      <p>
        The public experience could only feel calm if the operating model behind
        it was calm too. Event data changed, partners needed placements, hosts
        submitted updates, and launch traffic made manual recovery paths too
        risky to leave implicit.
      </p>
    </section>

    <section class="case-section" aria-labelledby="case-threads" data-case-section>
      <div class="case-section-label">
        <h2 id="case-threads">Threads</h2>
        <p>Publishing the programme, supporting people, and running partner campaigns.</p>
      </div>
      <div class="case-thread-grid">
        {
          threads.map((thread) => (
            <button
              class="case-thread"
              type="button"
              data-thread={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              <span>{thread.label}</span>
              <small>{thread.tension}</small>
            </button>
          ))
        }
      </div>
    </section>

    <section class="case-section" aria-labelledby="case-owned" data-case-section>
      <div class="case-section-label">
        <h2 id="case-owned">Owned</h2>
        <p>What I built and what it enabled.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Thread</th>
            <th scope="col">Work</th>
            <th scope="col">Outcome</th>
          </tr>
        </thead>
        <tbody>
          {
            threads.map((thread) => (
              <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
                <td>{thread.label}</td>
                <td>{thread.owned}</td>
                <td>{thread.proof}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section" aria-labelledby="case-mechanism" data-case-section>
      <div class="case-section-label">
        <h2 id="case-mechanism">Mechanism</h2>
        <p>The technical choices beneath the operating model.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Layer</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            mechanisms.map((mechanism) => (
              <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
                <td>{mechanism.layer}</td>
                <td>{mechanism.detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section" aria-labelledby="case-reflection" data-case-section>
      <div class="case-section-label">
        <h2 id="case-reflection">Reflection</h2>
        <p>What the project clarified about launch systems.</p>
      </div>
      <p>
        The important work was making the launch less dependent on a single
        perfect path. A public campaign can absorb change when data, publishing,
        recovery, placements, and reporting each have explicit contracts.
      </p>
    </section>

    <RelatedCaseStudies currentHref="/work/fete-finder-operations" />
  </article>

  <CaseStudyInteractions />
</BaseLayout>
