---
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import CaseStudySection from "../../components/CaseStudySection.astro";

const threads = [
  {
    key: "data",
    label: "Publish updates",
    owned: "Built event-data workflows with validation, revision history, backups, and import/export paths.",
    enables: "The team can inspect programme changes and work from recoverable records."
  },
  {
    key: "audience",
    label: "Support the audience",
    owned: "Built registration, submission moderation, saved-plan, and ticket-exchange tools.",
    enables: "People can contribute listings and organise their plans beyond the initial search."
  },
  {
    key: "partners",
    label: "Run placements",
    owned: "Built promoted-event scheduling, activation, reports, and exports.",
    enables: "Partner work has an operational path from scheduled placement to engagement reporting."
  }
];
const mechanisms = [
  {
    thread: "data",
    layer: "Keep a recoverable programme",
    detail: "Postgres holds live records, with revisions and backup paths available for inspection and recovery. CSV remains an import/export and fallback format rather than the only copy of the programme."
  },
  {
    thread: "audience",
    layer: "Review submissions before publishing",
    detail: "A contributed event needs an editorial decision before it belongs in the public programme. Moderation makes that step visible to the team."
  },
  {
    thread: "partners",
    layer: "Make the placement lifecycle explicit",
    detail: "Schedules and activation determine when a promoted placement is eligible. Engagement reports give partners a record to inspect, rather than treating a live link as the whole deliverable."
  }
];
const initialThread = "data";
---

<CaseStudyLayout title="Fête Finder Operations" description="The publishing, audience, and partner tools behind Fête Finder’s event programme." threads={threads} initialThread={initialThread}>
  <p slot="intro">The programme keeps changing after the website ships. I built tools for editing listings, reviewing submissions, supporting the audience, and reporting on partner placements.</p>
  <dl slot="meta" class="case-meta" aria-label="Case study summary">
    <div><dt>Context</dt><dd>Out Of Office Collective / 2025–26</dd></div>
    <div><dt>Focus</dt><dd>Programme data, submissions, partners, recovery</dd></div>
    <div><dt>Project</dt><dd><a href="https://fete.outofofficecollective.co.uk">fete.outofofficecollective.co.uk</a></dd></div>
  </dl>

  <CaseStudySection id="case-problem" title="Problem">
    <p>Organisers change details, people submit events, and partners need placements to start and end on time. Those changes need a clear route to the public programme, with a way to inspect and recover the data behind it.</p>
  </CaseStudySection>

  <CaseStudySection id="case-contribution" title="My contribution">
    <table class="case-ledger">
      <thead><tr><th scope="col">Area</th><th scope="col">What I built and why</th></tr></thead>
      <tbody>{threads.map((thread) => (
        <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
          <th scope="row">{thread.label}</th><td><p>{thread.owned}</p><p>{thread.enables}</p></td>
        </tr>
      ))}</tbody>
    </table>
  </CaseStudySection>

  <CaseStudySection id="case-decisions" title="Decisions">
    <div class="case-prose">
      <table class="case-ledger">
        <thead><tr><th scope="col">Choice</th><th scope="col">Why it matters</th></tr></thead>
        <tbody>{mechanisms.map((mechanism) => (
          <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
            <th scope="row">{mechanism.layer}</th><td>{mechanism.detail}</td>
          </tr>
        ))}</tbody>
      </table>

    </div>
  </CaseStudySection>

  <CaseStudySection id="case-result" title="What it enables">
    <div class="case-prose"><p>The operational tools connect programme editing, audience contributions, and partner work. A changed listing can be traced through the data workflow, and the team has recovery tools when the live records need attention.</p></div>
  </CaseStudySection>

  <CaseStudySection id="case-lesson" title="Lesson">
    <p>A launch needs more than a publish button. The valuable questions are who can change a record, how the team sees that change, and what they can recover if it is wrong. Those questions also make the next season easier to prepare.</p>
  </CaseStudySection>
</CaseStudyLayout>
