---
import BaseLayout from "../../layouts/BaseLayout.astro";

const threads = [
  {
    key: "data",
    label: "Runtime data",
    tension: "A live programme needed editable data without making the public site depend on a fragile manual spreadsheet loop.",
    owned: "Built a Postgres-backed event store, CSV import/export paths, backups, local fallback, validation, and revalidation controls.",
    proof: "The public site could keep serving useful event data even when the live store needed recovery or republishing.",
  },
  {
    key: "admin",
    label: "Admin workflow",
    tension: "Content, submissions, placements, health checks, and recovery actions needed to be usable under launch pressure.",
    owned: "Built admin surfaces for content editing, operations, placements, insights, submissions moderation, runtime health, and rollback.",
    proof: "The launch workflow became a set of explicit operational moves rather than a bundle of manual interventions.",
  },
  {
    key: "partners",
    label: "Partner signal",
    tension: "Campaign placements needed to be scheduled, fulfilled, measured, and reported without confusing editorial discovery.",
    owned: "Built spotlight/promoted scheduling, partner activation queues, tokenized partner stats, engagement tracking, and reporting exports.",
    proof: "Commercial placements could be operated with traceable performance without breaking the public discovery experience.",
  },
];

const mechanisms = [
  {
    thread: "data",
    layer: "Source chain",
    detail: "Managed Postgres event store first, latest backup second, bundled CSV fallback last.",
  },
  {
    thread: "data",
    layer: "Data quality",
    detail: "Event assembly, date normalization, event keys, field transformers, quality checks, and warning surfaces.",
  },
  {
    thread: "admin",
    layer: "Publishing",
    detail: "Event sheet editor, manual backups, save-and-revalidate flow, live runtime snapshot, and restore path.",
  },
  {
    thread: "admin",
    layer: "Security",
    detail: "Admin sessions, route-level authentication, cron secrets, deploy revalidation tokens, and rate-limit storage.",
  },
  {
    thread: "partners",
    layer: "Placements",
    detail: "Featured schedule, promoted schedule, Stripe activation ingestion, partner queues, and tokenized reporting pages.",
  },
  {
    thread: "partners",
    layer: "Analytics",
    detail: "Event engagement, discovery analytics, calendar-save signal, outbound clicks, partner rates, and CSV export.",
  },
];

const initialThread = "data";
---

<BaseLayout
  title="Fete Finder Operations - Owen Abel Amenze"
  description="A case study on Fete Finder's data model, admin workflow, partner placements, and launch operations."
>
  <article class="case-note" data-case-note data-active-thread={initialThread}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/work">Work</a>
      <span aria-hidden="true">/</span>
      <span>Fete Finder Operations</span>
    </nav>

    <header class="case-hero">
      <p class="eyebrow">Case study</p>
      <h1>Fete Finder Operations</h1>
      <p>
        Work on the system behind the public programme: data management,
        publishing, backups, placements, analytics, and the launch controls that
        kept a cultural product dependable across 3,000+ registrations and
        50,000+ unique visitors.
      </p>
    </header>

    <dl class="case-meta" aria-label="Case note summary">
      <div>
        <dt>Context</dt>
        <dd>Out Of Office Collective / 2025-26</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Postgres, admin workflows, backups, revalidation, partner reporting, analytics</dd>
      </div>
      <div>
        <dt>Link</dt>
        <dd>
          <a href="https://fete.outofofficecollective.co.uk">fete.outofofficecollective.co.uk</a>
        </dd>
      </div>
    </dl>

    <nav class="case-control" aria-label="Case study controls">
      <p>
        <span>Navigate</span>
        <kbd>↑</kbd><kbd>↓</kbd> sections
        <kbd>←</kbd><kbd>→</kbd> threads
        <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> direct
      </p>
      <div>
        {
          threads.map((thread, index) => (
            <button
              type="button"
              data-thread-control={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              [{index + 1}] {thread.label}
            </button>
          ))
        }
      </div>
    </nav>

    <section class="case-section" aria-labelledby="case-tension" data-case-section>
      <div class="case-section-label">
        <h2 id="case-tension">Tension</h2>
        <p>The product problem beneath the work.</p>
      </div>
      <p>
        The public experience could only feel calm if the operating model behind
        it was calm too. Event data changed, partners needed placements, hosts
        submitted updates, and launch traffic made manual recovery paths too
        risky to leave implicit.
      </p>
    </section>

    <section class="case-section" aria-labelledby="case-threads" data-case-section>
      <div class="case-section-label">
        <h2 id="case-threads">Threads</h2>
        <p>Three operational systems beneath the public surface.</p>
      </div>
      <div class="case-thread-grid">
        {
          threads.map((thread) => (
            <button
              class="case-thread"
              type="button"
              data-thread={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              <span>{thread.label}</span>
              <small>{thread.tension}</small>
            </button>
          ))
        }
      </div>
    </section>

    <section class="case-section" aria-labelledby="case-owned" data-case-section>
      <div class="case-section-label">
        <h2 id="case-owned">Owned</h2>
        <p>What I was responsible for, and what it changed.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Thread</th>
            <th scope="col">Work</th>
            <th scope="col">Signal</th>
          </tr>
        </thead>
        <tbody>
          {
            threads.map((thread) => (
              <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
                <td>{thread.label}</td>
                <td>{thread.owned}</td>
                <td>{thread.proof}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section" aria-labelledby="case-mechanism" data-case-section>
      <div class="case-section-label">
        <h2 id="case-mechanism">Mechanism</h2>
        <p>The technical layers behind those responsibilities.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Layer</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            mechanisms.map((mechanism) => (
              <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
                <td>{mechanism.layer}</td>
                <td>{mechanism.detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section case-flow" aria-labelledby="case-shape" data-case-section>
      <div class="case-section-label">
        <h2 id="case-shape">Shape</h2>
        <p>How the work moved from edits to launch confidence.</p>
      </div>
      <ol>
        <li data-thread="data" data-active>Event data enters through admin, import, or submission paths.</li>
        <li data-thread="data" data-active>Assembly and validation turn messy rows into stable public event objects.</li>
        <li data-thread="admin">Operators back up, publish, revalidate, and inspect runtime status.</li>
        <li data-thread="partners">Placements are scheduled and fulfilled without becoming hard-coded editorial state.</li>
        <li data-thread="partners">Engagement and partner reports turn launch activity into a measurable signal.</li>
      </ol>
    </section>

    <section class="case-section" aria-labelledby="case-reflection" data-case-section>
      <div class="case-section-label">
        <h2 id="case-reflection">Reflection</h2>
        <p>What the project clarified about launch systems.</p>
      </div>
      <p>
        The important work was making the launch less dependent on a single
        perfect path. A public campaign can absorb change when data, publishing,
        recovery, placements, and reporting each have explicit contracts.
      </p>
    </section>

    <section class="case-section related-case" aria-labelledby="related-case">
      <div class="case-section-label">
        <h2 id="related-case">Related</h2>
        <p>The public discovery surface those systems supported.</p>
      </div>
      <p>
        <a href="/work/fete-finder-discovery">Fete Finder: discovery, maps, and share links</a>
      </p>
    </section>
  </article>

  <script>
    const caseNote = document.querySelector("[data-case-note]");
    const controls = Array.from(caseNote.querySelectorAll(".case-thread[data-thread]"));
    const threadControls = Array.from(caseNote.querySelectorAll("[data-thread-control]"));
    const related = caseNote.querySelectorAll("[data-thread]");
    const sections = Array.from(caseNote.querySelectorAll("[data-case-section]"));

    const applyThread = (key) => {
      caseNote.dataset.activeThread = key ?? "";

      related.forEach((node) => {
        const active = Boolean(key) && node.dataset.thread === key;
        node.toggleAttribute("data-active", active);

        if (node.matches(".case-thread")) {
          node.setAttribute("aria-pressed", String(active));
        }
      });

      threadControls.forEach((control) => {
        const active = Boolean(key) && control.dataset.threadControl === key;
        control.toggleAttribute("data-active", active);
        control.setAttribute("aria-pressed", String(active));
      });
    };

    const toggleThread = (key) => {
      applyThread(caseNote.dataset.activeThread === key ? undefined : key);
    };

    const activeThreadIndex = () => {
      const index = controls.findIndex((control) => control.dataset.thread === caseNote.dataset.activeThread);
      return index < 0 ? 0 : index;
    };

    const moveThread = (amount) => {
      const nextControl = controls[(activeThreadIndex() + amount + controls.length) % controls.length];

      nextControl.focus({ preventScroll: true });
      applyThread(nextControl.dataset.thread);
    };

    const currentSectionIndex = () => {
      const viewportAnchor = window.scrollY + window.innerHeight * 0.28;

      for (let index = sections.length - 1; index >= 0; index -= 1) {
        if (sections[index].offsetTop <= viewportAnchor) {
          return index;
        }
      }

      return -1;
    };

    const moveSection = (amount) => {
      const currentIndex = currentSectionIndex();
      const firstSectionTop = sections[0].offsetTop;
      const isNearFirstSection = window.scrollY <= firstSectionTop;

      if (amount < 0 && (currentIndex <= 0 || isNearFirstSection)) {
        window.scrollTo({
          top: Math.max(0, caseNote.offsetTop - 18),
          behavior: "smooth",
        });
        return;
      }

      const nextIndex = Math.min(Math.max(currentIndex + amount, 0), sections.length - 1);
      sections[nextIndex].scrollIntoView({ behavior: "smooth", block: "start" });
    };

    controls.forEach((control, index) => {
      control.addEventListener("click", () => toggleThread(control.dataset.thread));
      control.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];

        if (!keys.includes(event.key)) {
          return;
        }

        event.preventDefault();

        const nextIndex =
          {
            ArrowRight: (index + 1) % controls.length,
            ArrowLeft: (index - 1 + controls.length) % controls.length,
            Home: 0,
            End: controls.length - 1,
          }[event.key] ?? index;
        const nextControl = controls[nextIndex];

        nextControl.focus({ preventScroll: true });
        applyThread(nextControl.dataset.thread);
      });
    });

    threadControls.forEach((control) => {
      control.addEventListener("click", () => {
        applyThread(control.dataset.threadControl);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.defaultPrevented || event.metaKey || event.altKey || event.ctrlKey) {
        return;
      }

      if (!caseNote.contains(event.target) && event.target !== document.body) {
        return;
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();
        moveSection(1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        moveSection(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        moveThread(1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        moveThread(-1);
      } else if (["1", "2", "3"].includes(event.key)) {
        event.preventDefault();
        applyThread(controls[Number(event.key) - 1].dataset.thread);
      } else if (event.key === "Escape") {
        applyThread();
      }
    });
  </script>
</BaseLayout>
