---
import BaseLayout from "../../layouts/BaseLayout.astro";

const threads = [
  {
    key: "storage",
    label: "Storage model",
    tension: "Travel writing, party albums, camera rolls, private notes, and shared assets all needed a home without becoming expensive or fragile.",
    owned: "Separated permanent albums, words content, reusable assets, and private share surfaces across git manifests, KV metadata, and R2 object paths.",
    proof: "The site can hold thoughts and photo archives in one owned place while keeping large media cheap to store and serve.",
  },
  {
    key: "images",
    label: "Image pipeline",
    tension: "People should be able to browse an event, find themselves, and download the right image without asking for a separate transfer.",
    owned: "Built processing for thumbnails, full-size variants, originals, Open Graph images, focal points, rotation handling, filtering, sorting, and face-aware crops.",
    proof: "Large photo sets get fast previews, sensible crops, and HD downloads from Cloudflare R2/CDN instead of expensive one-off sharing tools.",
  },
  {
    key: "publishing",
    label: "Publishing surface",
    tension: "The same place needed to hold public writing, unlisted notes, private vault entries, and photo-led memory without creating separate systems.",
    owned: "Built the unified words model with markdown bodies in R2, KV metadata, visibility controls, signed share links, and reusable media references.",
    proof: "Writing and photography can live together without sacrificing access control, editorial presentation, or storage clarity.",
  },
];

const mechanisms = [
  {
    thread: "storage",
    layer: "Album manifests",
    detail: "Permanent galleries use JSON manifests in git with R2-backed media, giving public album pages static speed and low runtime cost.",
  },
  {
    thread: "storage",
    layer: "Words storage",
    detail: "Words metadata lives in KV while markdown bodies and media live in R2 under stable paths.",
  },
  {
    thread: "images",
    layer: "Variants",
    detail: "Images produce thumbnail, full, original, and social-preview variants; GIFs, video, audio, documents, and archives follow file-appropriate paths.",
  },
  {
    thread: "images",
    layer: "Focal points",
    detail: "ONNX face detection or Sharp saliency computes crop anchors, with manual overrides for album-level editorial control.",
  },
  {
    thread: "images",
    layer: "Social previews",
    detail: "Album and photo Open Graph images are pre-built as 1200x630 JPGs in R2 to avoid runtime image generation on normal shares.",
  },
  {
    thread: "publishing",
    layer: "Visibility",
    detail: "Public and unlisted words render through the editorial route; private words resolve through vault links with share-token and optional PIN gates.",
  },
  {
    thread: "publishing",
    layer: "Reusable media",
    detail: "Word-specific media and shared assets use explicit R2 prefixes so markdown can reference files without duplicating uploads.",
  },
];

const initialThread = "storage";
---

<BaseLayout
  title="Milk & Henny Media - Owen Abel Amenze"
  description="A case study on Milk & Henny's personal archive, image pipeline, and media publishing model."
>
  <article class="case-note" data-case-note data-active-thread={initialThread}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/work">Work</a>
      <span aria-hidden="true">/</span>
      <span>Milk & Henny Media</span>
    </nav>

    <header class="case-hero">
      <p class="eyebrow">Case study</p>
      <h1>Milk & Henny Media</h1>
      <p>
        Work on a personal archive for travel, writing, parties, and the photos
        I take on digital and film cameras, built so memory can be published and
        shared without becoming admin.
      </p>
    </header>

    <dl class="case-meta" aria-label="Case study summary">
      <div>
        <dt>Context</dt>
        <dd>Personal platform / 2025</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>Cloudflare R2, image variants, filtering, downloads, focal points, private publishing</dd>
      </div>
      <div>
        <dt>Link</dt>
        <dd>
          <a href="https://milkandhenny.com">milkandhenny.com</a>
        </dd>
      </div>
    </dl>

    <nav class="case-control" aria-label="Case study controls">
      <p>
        <span>Navigate</span>
        <kbd>↑</kbd><kbd>↓</kbd> sections
        <kbd>←</kbd><kbd>→</kbd> threads
        <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> direct
      </p>
      <div>
        {
          threads.map((thread, index) => (
            <button
              type="button"
              data-thread-control={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              [{index + 1}] {thread.label}
            </button>
          ))
        }
      </div>
    </nav>

    <section class="case-section" aria-labelledby="case-tension" data-case-section>
      <div class="case-section-label">
        <h2 id="case-tension">Tension</h2>
        <p>The product problem beneath the work.</p>
      </div>
      <p>
        I travel, write, meet people, and take a lot of photos. After parties
        and trips, the same problem repeats: people want their photos, large
        batches are awkward to send, and temporary file-sharing tools become
        expensive or disposable. Milk & Henny turns that loop into an owned
        archive with optimized previews, filters, sorting, and HD downloads.
      </p>
    </section>

    <section class="case-section" aria-labelledby="case-threads" data-case-section>
      <div class="case-section-label">
        <h2 id="case-threads">Threads</h2>
        <p>Three contracts behind the archive surface.</p>
      </div>
      <div class="case-thread-grid">
        {
          threads.map((thread) => (
            <button
              class="case-thread"
              type="button"
              data-thread={thread.key}
              data-active={thread.key === initialThread ? true : undefined}
              aria-pressed={thread.key === initialThread ? "true" : "false"}
            >
              <span>{thread.label}</span>
              <small>{thread.tension}</small>
            </button>
          ))
        }
      </div>
    </section>

    <section class="case-section" aria-labelledby="case-owned" data-case-section>
      <div class="case-section-label">
        <h2 id="case-owned">Owned</h2>
        <p>What I was responsible for, and what it changed.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Thread</th>
            <th scope="col">Work</th>
            <th scope="col">Signal</th>
          </tr>
        </thead>
        <tbody>
          {
            threads.map((thread) => (
              <tr data-thread={thread.key} data-active={thread.key === initialThread ? true : undefined}>
                <td>{thread.label}</td>
                <td>{thread.owned}</td>
                <td>{thread.proof}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section" aria-labelledby="case-mechanism" data-case-section>
      <div class="case-section-label">
        <h2 id="case-mechanism">Mechanism</h2>
        <p>The technical layers behind those responsibilities.</p>
      </div>
      <table class="case-ledger">
        <thead>
          <tr>
            <th scope="col">Layer</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            mechanisms.map((mechanism) => (
              <tr data-thread={mechanism.thread} data-active={mechanism.thread === initialThread ? true : undefined}>
                <td>{mechanism.layer}</td>
                <td>{mechanism.detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="case-section case-flow" aria-labelledby="case-shape" data-case-section>
      <div class="case-section-label">
        <h2 id="case-shape">Shape</h2>
        <p>How media becomes browsable and shareable.</p>
      </div>
      <ol>
        <li data-thread="storage" data-active>Content enters through a route that matches its lifecycle: album, word, shared asset, or private entry.</li>
        <li data-thread="images">Photo uploads generate fast previews, HD variants, and social-preview assets before anyone needs them.</li>
        <li data-thread="images">Filtering, sorting, focal points, and crops help people find and recognize the photos they came for.</li>
        <li data-thread="publishing">Markdown references resolve against explicit R2 media paths and reusable asset paths.</li>
        <li data-thread="publishing">Visibility rules decide whether the result is public, unlisted, or privately shareable.</li>
      </ol>
    </section>

    <section class="case-section" aria-labelledby="case-reflection" data-case-section>
      <div class="case-section-label">
        <h2 id="case-reflection">Reflection</h2>
        <p>What the project clarified about owning the archive.</p>
      </div>
      <p>
        The real product is relief: a place to put the writing, the camera
        rolls, the party albums, and the people who ask for them later. The
        storage model matters because it lets the archive feel generous without
        becoming expensive.
      </p>
    </section>
  </article>

  <script>
    const caseNote = document.querySelector("[data-case-note]");
    const controls = Array.from(caseNote.querySelectorAll(".case-thread[data-thread]"));
    const threadControls = Array.from(caseNote.querySelectorAll("[data-thread-control]"));
    const related = caseNote.querySelectorAll("[data-thread]");
    const sections = Array.from(caseNote.querySelectorAll("[data-case-section]"));

    const applyThread = (key) => {
      caseNote.dataset.activeThread = key ?? "";

      related.forEach((node) => {
        const active = Boolean(key) && node.dataset.thread === key;
        node.toggleAttribute("data-active", active);

        if (node.matches(".case-thread")) {
          node.setAttribute("aria-pressed", String(active));
        }
      });

      threadControls.forEach((control) => {
        const active = Boolean(key) && control.dataset.threadControl === key;
        control.toggleAttribute("data-active", active);
        control.setAttribute("aria-pressed", String(active));
      });
    };

    const toggleThread = (key) => {
      applyThread(caseNote.dataset.activeThread === key ? undefined : key);
    };

    const activeThreadIndex = () => {
      const index = controls.findIndex((control) => control.dataset.thread === caseNote.dataset.activeThread);
      return index < 0 ? 0 : index;
    };

    const moveThread = (amount) => {
      const nextControl = controls[(activeThreadIndex() + amount + controls.length) % controls.length];

      nextControl.focus({ preventScroll: true });
      applyThread(nextControl.dataset.thread);
    };

    const currentSectionIndex = () => {
      const viewportAnchor = window.scrollY + window.innerHeight * 0.28;

      for (let index = sections.length - 1; index >= 0; index -= 1) {
        if (sections[index].offsetTop <= viewportAnchor) {
          return index;
        }
      }

      return -1;
    };

    const moveSection = (amount) => {
      const currentIndex = currentSectionIndex();
      const firstSectionTop = sections[0].offsetTop;
      const isNearFirstSection = window.scrollY <= firstSectionTop;

      if (amount < 0 && (currentIndex <= 0 || isNearFirstSection)) {
        window.scrollTo({
          top: Math.max(0, caseNote.offsetTop - 18),
          behavior: "smooth",
        });
        return;
      }

      const nextIndex = Math.min(Math.max(currentIndex + amount, 0), sections.length - 1);
      sections[nextIndex].scrollIntoView({ behavior: "smooth", block: "start" });
    };

    controls.forEach((control, index) => {
      control.addEventListener("click", () => toggleThread(control.dataset.thread));
      control.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];

        if (!keys.includes(event.key)) {
          return;
        }

        event.preventDefault();

        const nextIndex =
          {
            ArrowRight: (index + 1) % controls.length,
            ArrowLeft: (index - 1 + controls.length) % controls.length,
            Home: 0,
            End: controls.length - 1,
          }[event.key] ?? index;
        const nextControl = controls[nextIndex];

        nextControl.focus({ preventScroll: true });
        applyThread(nextControl.dataset.thread);
      });
    });

    threadControls.forEach((control) => {
      control.addEventListener("click", () => {
        applyThread(control.dataset.threadControl);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.defaultPrevented || event.metaKey || event.altKey || event.ctrlKey) {
        return;
      }

      if (!caseNote.contains(event.target) && event.target !== document.body) {
        return;
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();
        moveSection(1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        moveSection(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        moveThread(1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        moveThread(-1);
      } else if (["1", "2", "3"].includes(event.key)) {
        event.preventDefault();
        applyThread(controls[Number(event.key) - 1].dataset.thread);
      } else if (event.key === "Escape") {
        applyThread();
      }
    });
  </script>
</BaseLayout>
