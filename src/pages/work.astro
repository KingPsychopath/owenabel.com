---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCaseNotes, work } from "../data/work";
---

<BaseLayout
  title="Work - Owen Abel Amenze"
  description="Selected software engineering work by Owen Abel Amenze."
>
  <h1 class="page-title">Selected systems, kept deliberately brief.</h1>

  <section class="section-header" aria-labelledby="work-heading">
    <h2 id="work-heading">Work</h2>
    <p>
      I am most useful where product sense meets technical ambiguity.
    </p>
  </section>

  <div class="work-list">
    {
      work.map((item) => (
        <article class="work-item" data-work-item>
          <span>{item.year}</span>
          <div>
            <h3>
              <a href={getCaseNotes(item)[0]?.href ?? item.href}>{item.name}</a>
            </h3>
            <p>{item.detail}</p>
            <div class="work-detail">
              <details>
                <summary>More detail</summary>
                <dl>
                <div>
                  <dt>Tension</dt>
                  <dd>
                    {
                      Array.isArray(item.tension)
                        ? item.tension.map((part) =>
                            part.key ? (
                              <button
                                type="button"
                                class="relation-text"
                                data-relation={part.key}
                                aria-pressed="false"
                              >
                                {part.text}
                              </button>
                            ) : (
                              part.text
                            ),
                          )
                        : item.tension
                    }
                  </dd>
                </div>
                <div>
                  <dt>{item.streams ? "Workstreams" : "Owned"}</dt>
                  <dd>
                    {
                      item.streams ? (
                        <ol class="work-streams" data-relation-list>
                          {item.streams.map((stream) => (
                            <li>
                              <button type="button" data-relation={stream.key} aria-pressed="false">
                                <strong>{stream.label}</strong>
                                <span>{stream.body}</span>
                              </button>
                            </li>
                          ))}
                        </ol>
                      ) : (
                        item.owned
                      )
                    }
                  </dd>
                </div>
                <div>
                  <dt>Signal</dt>
                  <dd>
                    {
                      Array.isArray(item.signal)
                        ? item.signal.map((part) =>
                            part.key ? (
                              <button
                                type="button"
                                class="relation-text"
                                data-relation={part.key}
                                aria-pressed="false"
                              >
                                {part.text}
                              </button>
                            ) : (
                              part.text
                            ),
                          )
                        : item.signal
                    }
                  </dd>
                </div>
                <div>
                  <dt>Links</dt>
                  <dd>
                    {item.links.map((link, index) => (
                      <>
                        {index > 0 && " / "}
                        <a href={link.href} data-relation={link.key}>
                          {link.label}
                        </a>
                      </>
                    ))}
                  </dd>
                </div>
                {
                  getCaseNotes(item).length > 0 && (
                    <div>
                      <dt>{getCaseNotes(item).length > 1 ? "Case studies" : "Case study"}</dt>
                      <dd>
                        <ol class="case-study-list">
                          {getCaseNotes(item).map((caseNote, index) => (
                            <li>
                              <a href={caseNote.href}>
                                <span class="case-study-ref" aria-hidden="true">[{index + 1}]</span>
                                {caseNote.label}
                              </a>
                            </li>
                          ))}
                        </ol>
                      </dd>
                    </div>
                  )
                }
                </dl>
              </details>
              {
                getCaseNotes(item).length > 0 && (
                  <nav class="case-study-shortcuts" aria-label={`${item.name} case studies`}>
                    {getCaseNotes(item).map((caseNote, index) => (
                      <a
                        class="case-study-count"
                        href={caseNote.href}
                        aria-label={`Case study ${index + 1}: ${caseNote.label}`}
                      >
                        [{index + 1}]
                      </a>
                    ))}
                  </nav>
                )
              }
            </div>
          </div>
          <span class="work-role">{item.role}</span>
        </article>
      ))
    }
  </div>

  <script>
    const relationItems = document.querySelectorAll<HTMLElement>("[data-work-item]");

    const updatePressedState = (item: HTMLElement) => {
      item.querySelectorAll<HTMLButtonElement>('button[data-relation]').forEach((node) => {
        node.setAttribute("aria-pressed", String(item.dataset.pinnedRelation === node.dataset.relation));
      });
    };

    const clearItem = (item: HTMLElement) => {
      delete item.dataset.pinnedRelation;
      item.querySelectorAll<HTMLElement>("[data-relation]").forEach((node) => {
        node.removeAttribute("data-active");
      });
      updatePressedState(item);
    };

    for (const item of relationItems) {
      const setActive = (key: string | undefined, persist = false) => {
        if (persist) {
          if (item.dataset.pinnedRelation === key) {
            delete item.dataset.pinnedRelation;
            key = undefined;
          } else {
            item.dataset.pinnedRelation = key ?? "";
          }
        }

        item.querySelectorAll<HTMLElement>("[data-relation]").forEach((node) => {
          node.toggleAttribute("data-active", Boolean(key) && node.dataset.relation === key);
        });
        updatePressedState(item);
      };

      item.querySelectorAll<HTMLElement>(".work-streams button[data-relation], .relation-text[data-relation]").forEach((node) => {
        node.addEventListener("mouseenter", () => setActive(node.dataset.relation));
        node.addEventListener("focus", () => setActive(node.dataset.relation));
        node.addEventListener("click", () => setActive(node.dataset.relation, true));
      });

      item.addEventListener("mouseleave", () => {
        setActive(item.dataset.pinnedRelation);
      });
    }

    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-relation]")) {
        return;
      }

      relationItems.forEach(clearItem);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        relationItems.forEach(clearItem);
      }
    });
  </script>
</BaseLayout>
