---
import BaseLayout from "../layouts/BaseLayout.astro";

const work = [
  {
    year: "2025-26",
    name: "Fete Finder",
    href: "https://fete.outofofficecollective.co.uk",
    detail:
      "A cultural event discovery platform for Fete de la Musique, built to make a large, scattered programme feel findable.",
    tension:
      "A city-wide programme is only useful if people can move through it by place, time, taste, and confidence.",
    owned:
      "Listings, maps, event pages, partner placements, admin workflows, and launch readiness under real campaign traffic.",
    signal:
      "Supported 3,000+ registrations and 50,000+ unique visitors during launch.",
    links: [{ label: "fete.outofofficecollective.co.uk", href: "https://fete.outofofficecollective.co.uk" }],
    role: "Product",
  },
  {
    year: "2023-26",
    name: "Jisc",
    href: "https://www.jisc.ac.uk",
    detail:
      "Platform work across search, content, infrastructure, and data services for products with institutional users.",
    tension:
      "Product surfaces depended on records, publishing flows, and infrastructure that needed to stay reliable while changing.",
    owned:
      "CMS delivery, AWS migration work, search indexing, release validation, and coordination between product and data teams.",
    signal:
      "Lower release risk and better source data made downstream product experiences easier to trust.",
    links: [
      { label: "openpolicyfinder.jisc.ac.uk", href: "https://openpolicyfinder.jisc.ac.uk" },
      { label: "jisc.ac.uk", href: "https://www.jisc.ac.uk" },
    ],
    role: "Senior",
  },
  {
    year: "2026",
    name: "Receipts",
    href: "https://receipts.beauty",
    detail:
      "A trust-first beauty discovery platform designed around evidence, not empty ranking theatre.",
    tension:
      "Beauty discovery often asks people to trust opaque recommendations; the product needed to show its working.",
    owned:
      "Product architecture, authentication, typed contracts, ranking logic, async work, and operational visibility.",
    signal:
      "Trust becomes part of the interface rather than a claim made after the fact.",
    links: [{ label: "receipts.beauty", href: "https://receipts.beauty" }],
    role: "Founder",
  },
  {
    year: "2025",
    name: "Milk & Henny",
    href: "https://milkandhenny.com",
    detail:
      "A private content and media platform with careful handling of images, video, storage, and presentation.",
    tension:
      "A media-heavy product should feel quiet at the surface, even when storage, processing, and presentation are doing difficult work underneath.",
    owned:
      "Media storage, image transformation, video processing, focal-point handling, and the private publishing surface.",
    signal:
      "Made a media-heavy product feel simple at the point of use by moving complexity into the system.",
    links: [{ label: "milkandhenny.com", href: "https://milkandhenny.com" }],
    role: "Full stack",
  },
];
---

<BaseLayout
  title="Work - Owen Abel Amenze"
  description="Selected software engineering work by Owen Abel Amenze."
>
  <h1 class="page-title">Selected systems, kept deliberately brief.</h1>

  <section class="section-header" aria-labelledby="work-heading">
    <h2 id="work-heading">Work</h2>
    <p>
      I am most useful where product sense meets technical ambiguity: search,
      data quality, launch readiness, infrastructure, and the quiet details that
      make software feel dependable.
    </p>
  </section>

  <div class="work-list">
    {
      work.map((item) => (
        <article class="work-item">
          <span>{item.year}</span>
          <div>
            <h3>
              <a href={item.href}>{item.name}</a>
            </h3>
            <p>{item.detail}</p>
            <details>
              <summary>More detail</summary>
              <dl>
                <div>
                  <dt>Tension</dt>
                  <dd>{item.tension}</dd>
                </div>
                <div>
                  <dt>Owned</dt>
                  <dd>{item.owned}</dd>
                </div>
                <div>
                  <dt>Signal</dt>
                  <dd>{item.signal}</dd>
                </div>
                <div>
                  <dt>Links</dt>
                  <dd>
                    {item.links.map((link, index) => (
                      <>
                        {index > 0 && " / "}
                        <a href={link.href}>{link.label}</a>
                      </>
                    ))}
                  </dd>
                </div>
              </dl>
            </details>
          </div>
          <span>{item.role}</span>
        </article>
      ))
    }
  </div>
</BaseLayout>
