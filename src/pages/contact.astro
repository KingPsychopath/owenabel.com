---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact - Owen Abel Amenze"
  description="Contact Owen Abel Amenze for software engineering work."
>
  <h1 class="page-title">A small door, deliberately left open.</h1>

  <section class="contact-panel" aria-label="Contact details">
    <div class="contact-row">
      <span>Email</span>
      <!--email_off-->
      <span class="contact-value">
        <a href="mailto:work@owenabel.com">work@owenabel.com</a>
        <button class="copy-button" type="button" data-copy-email="work@owenabel.com" aria-label="Copy work email">
          Copy
        </button>
        <span class="copy-status" data-copy-status aria-live="polite"></span>
      </span>
      <!--/email_off-->
    </div>
    <div class="contact-row">
      <span>GitHub</span>
      <a href="https://github.com/KingPsychopath">github.com/KingPsychopath</a>
    </div>
    <div class="contact-row">
      <span>LinkedIn</span>
      <a href="https://www.linkedin.com/in/owen-abel"
        >linkedin.com/in/owen-abel</a
      >
    </div>
    <div class="contact-row">
      <span>CV</span>
      <a href="/owen-abel-amenze-cv.pdf">Download PDF</a>
    </div>
  </section>

  <script>
    const copyButton = document.querySelector("[data-copy-email]");
    const copyStatus = document.querySelector("[data-copy-status]");

    copyButton?.addEventListener("click", async () => {
      const email = copyButton.dataset.copyEmail;

      if (!email) {
        return;
      }

      try {
        await navigator.clipboard.writeText(email);
        copyButton.textContent = "Copied";
        copyStatus.textContent = "Email copied.";
        window.setTimeout(() => {
          copyButton.textContent = "Copy";
          copyStatus.textContent = "";
        }, 1800);
      } catch {
        copyStatus.textContent = "Copy failed.";
      }
    });
  </script>
</BaseLayout>
