---
import "../styles/global.css";

const {
  title = "Owen Abel Amenze - Software Engineer",
  description = "Software engineer in London, making product systems clearer, calmer, and easier to trust under real use.",
  noindex = false,
} = Astro.props;

const ogImage = new URL("/og.png", Astro.site ?? Astro.url).href;

const nav = [
  { href: "/", label: "Index" },
  { href: "/work", label: "Work" },
  { href: "/contact", label: "Contact" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Owen Abel Amenze",
  jobTitle: "Software Engineer",
  url: "https://owenabel.com",
  image: ogImage,
  address: {
    "@type": "PostalAddress",
    addressLocality: "London",
    addressCountry: "GB",
  },
  sameAs: [
    "https://github.com/KingPsychopath",
    "https://www.linkedin.com/in/owen-abel",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <style is:inline>
      html {
        background: #efefec;
        color: #11110f;
        color-scheme: light;
      }

      html[data-theme="dark"] {
        background: #111213;
        color: #f3efe6;
        color-scheme: dark;
      }

      body {
        background-color: inherit;
      }
    </style>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("owenabel-theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

          if (theme === "dark" || (!theme && prefersDark)) {
            document.documentElement.dataset.theme = "dark";
          }
        } catch {
          // Theme is progressive enhancement; default paper stays readable.
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Owen Abel Amenze" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Owen Abel Amenze home">
          <strong>Owen Abel Amenze</strong>
          <span>Software Engineer / London</span>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="Use dark theme"
            aria-pressed="false"
          >
            ◐
          </button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div
          class="footer-microtext"
          aria-hidden="true"
          data-footer-microtext
        >
          according to all known laws of tasteful portfolio restraint there is no reason a tiny footer texture should contain this much honeyed administrative nonsense nevertheless the ledger continues invoice number wing-0001 line item soft landing line item improbable work ethic line item one small joke rendered almost invisible for quality assurance purposes please ignore this decorative transcript substitute it has no canonical relation to any animated feature film and exists only as a transparent paper grain for people who inspect too closely according to all known laws of tasteful portfolio restraint there is no reason a tiny footer texture should contain this much honeyed administrative nonsense nevertheless the ledger continues invoice number wing-0002 line item quiet systems line item calmer launches line item a barely readable joke hiding politely under the contact details
        </div>
        <span>Available for thoughtful engineering work.</span>
        <!--email_off-->
        <a href="mailto:work@owenabel.com">work@owenabel.com</a>
        <!--/email_off-->
      </footer>
    </div>
    <script>
      const themeToggle = document.querySelector("[data-theme-toggle]");
      const footerMicrotext = document.querySelector("[data-footer-microtext]");
      const setTheme = (theme) => {
        const isDark = theme === "dark";

        document.documentElement.dataset.theme = isDark ? "dark" : "";

        if (!isDark) {
          document.documentElement.removeAttribute("data-theme");
        }

        themeToggle?.setAttribute("aria-pressed", String(isDark));
        themeToggle?.setAttribute("aria-label", isDark ? "Use light theme" : "Use dark theme");
      };

      if (themeToggle) {
        const storedTheme = localStorage.getItem("owenabel-theme");
        const currentTheme =
          storedTheme ??
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

        setTheme(currentTheme);

        themeToggle.addEventListener("click", () => {
          const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";

          localStorage.setItem("owenabel-theme", nextTheme);
          setTheme(nextTheme);
        });
      }

      if (footerMicrotext) {
        fetch("/footer-microtext.txt")
          .then((response) => (response.ok ? response.text() : ""))
          .then((text) => {
            const normalized = text.replace(/\s+/g, " ").trim();

            if (normalized) {
              footerMicrotext.textContent = normalized;
            }
          })
          .catch(() => {
            // Decorative only; the inline fallback stays in place.
          });
      }
    </script>
  </body>
</html>
