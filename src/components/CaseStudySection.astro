---
interface Props {
  id: string;
  title: string;
  summary: string;
  class?: string;
}
const { id, title, summary, class: className } = Astro.props;
---
<section class:list={["case-section", className]} aria-labelledby={id} data-case-section>
  <div class="case-section-label">
    <h2 id={id}>{title}</h2>
    <p>{summary}</p>
  </div>
  <slot />
</section>
