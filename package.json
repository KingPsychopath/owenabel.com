{
  "name": "owenabel.com",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "format": "oxfmt --write . && prettier --write 'src/**/*.astro'",
    "format:check": "oxfmt --check . && prettier --check 'src/**/*.astro'",
    "lint": "oxlint --type-aware --deny-warnings . --ignore-pattern dist --ignore-pattern node_modules --ignore-pattern '*.astro'",
    "typecheck": "astro check && tsgo --noEmit",
    "build": "npm run format:check && npm run lint && npm run typecheck && astro build",
    "preview": "astro preview",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name owenabel-com --branch main"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@typescript/native-preview": "^7.0.0-dev.20260512.1",
    "astro": "^6.3.1",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.90.1"
  }
}
