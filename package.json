{
  "name": "owenabel.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:raw": "astro dev",
    "og:generate": "node scripts/generate-og.mjs",
    "prebuild": "pnpm run og:generate",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings . --ignore-pattern dist --ignore-pattern node_modules --ignore-pattern '*.astro'",
    "typecheck": "tsgo --noEmit",
    "build": "pnpm run format:check && pnpm run lint && pnpm run typecheck && astro build",
    "preview": "astro preview",
    "deploy:cf": "pnpm run build && wrangler pages deploy dist --project-name owenabel-com --branch main"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "astro": "^7.0.7",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "sharp": "0.34.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
