{
  "name": "owenabel.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:raw": "astro dev",
    "og:generate": "node scripts/generate-og.mjs",
    "prebuild": "pnpm run og:generate",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings . --ignore-pattern dist --ignore-pattern node_modules --ignore-pattern '*.astro'",
    "typecheck": "astro check && tsgo --noEmit",
    "build": "pnpm run format:check && pnpm run lint && pnpm run typecheck && astro build && node scripts/generate-redirects.mjs",
    "preview": "astro preview",
    "deploy:cf": "pnpm run build && wrangler pages deploy dist --project-name owenabel-com --branch main"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@typescript/native-preview": "^7.0.0-dev.20260512.1",
    "astro": "^7.3.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^0.25.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.142.0"
  },
  "packageManager": "pnpm@11.17.0"
}
